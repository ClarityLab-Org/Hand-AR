# Camera Configuration
CAMERA_INDEX=0

# MediaPipe Hand Detection Confidence
MIN_DETECTION_CONFIDENCE=0.8
MIN_TRACKING_CONFIDENCE=0.8

# Camera Feed Resolution (width x height)
FEED_WIDTH=320
FEED_HEIGHT=240

# Gesture Smoothing Factor (0-1, lower = smoother but laggy)
SMOOTHING_ALPHA=0.25

# Screenshot Directory
SCREENSHOT_DIR=./screenshots

# Point Cloud Rendering (space between points — higher = denser / less space, 1.0 - 10.0)
POINT_SIZE=3.0
POINT_THICKNESS=3.0

# Navigation Speeds
WALK_SPEED=6.0
FLIGHT_SPEED=16.0
VERTICAL_SPEED=8.0
TURN_SPEED=75.0
PITCH_SPEED=55.0

# Sketchfab API token (optional; enables web search and downloads)
SKETCHFAB_TOKEN=

# Debug Mode
DEBUG=False
